{
  "compilerOptions": {
    "target": "es2022",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "module": "ES2022",
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "sourceMap": true,
    "outDir": "esm"
  },
  "exclude": [
    "esm",
    "node_modules"
  ]
}