{
   "name": "jointhedots",
   "version": "2.0.11",
   "type": "module",
   "private": true,
   "license": "MIT",
   "workspaces": [
      "packages/*"
   ],
   "devDependencies": {
      "@jointhedots/gear": "./packages/jointhedots-gear",
      "@types/mocha": "^10.0.8",
      "@types/node": "^22.7.4",
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1",
      "@types/typescript": "^2.0.0",
      "esm": "^3.2.25",
      "mocha": "^10.7.3",
      "ts-json-schema-generator": "^2.4.0",
      "ts-node": "^10.9.2",
      "ts-patch": "^3.2.1",
      "tsconfig-paths": "^4.2.0",
      "typescript": "~5.6.3",
      "typescript-transform-paths": "^3.5.1"
   },
   "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "@salesforce-ux/design-system": "2.25.4",
      "react-lightning-design-system": {
         "react-relative-portal": "./deps/react-relative-portal-1.3.1.tgz"
      }
   },
   "scripts": {
      "watch": "tspc --watch --noEmit",
      "serve:svc": "jointhedots-gear serve --app playground:services --devmode --port 3001",
      "serve:ui": "jointhedots-gear serve --app playground:ui --devmode --port 3002",
      "build": "jointhedots-gear make --libs @jointhedots/core,@jointhedots/ui --pack --dist ./dist",
      "build:pwa": "jointhedots-gear make --watch --apps playground:services --dist ./dist",
      "build:ext": "jointhedots-gear make --watch --apps playground:app-chrome --dist ./dist",
      "make": "jointhedots-gear make --watch --libs @jointhedots/core,@jointhedots/ui --devmode --dist ../sf-explorer-app/dist",
      "test": "mocha"
   },
   "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447",
   "dependencies": {
      "@mui/material": "^6.4.7"
   }
}
