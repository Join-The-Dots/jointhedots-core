{
   "id": "poll",
   "description": "Simple online poll",
   "icon": "bi:patch-question-fill",
   "view": {
      "properties": {
         "question": {
            "type": "string"
         },
         "options": {
            "type": "array",
            "items": {
               "properties": {
                  "text": {
                     "type": "string"
                  },
                  "uid": {
                     "type": "string"
                  },
                  "votes": {
                     "type": "array",
                     "items": {
                        "type": "number",
                        "default": 0
                     }
                  }
               }
            }
         }
      }
   },
   "attachments": {
      "view.lexical": "./PollNode#PollNode",
      "addon.lexical": "./PollPlugin"
   }
}