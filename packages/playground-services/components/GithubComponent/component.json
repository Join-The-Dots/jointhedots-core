{
   "$id": "jtd:github.service",
   "title": "GitHub Repository Service",
   "icon": "fa:git",
   "tags": [
      "component.storage",
      "component.commands"
   ],
   "specs": {
      "component": {
         "attributes": {
            "settings": {
               "type": "object",
               "properties": {
                  "url": {
                     "type": "string"
                  },
                  "password": {
                     "type": "string"
                  },
                  "org": {
                     "type": "string"
                  },
                  "repo": {
                     "type": "string"
                  },
                  "branch": {
                     "type": "string"
                  }
               },
               "required": [
                  "url",
                  "password",
                  "org",
                  "branch"
               ]
            }
         }
      },
      "component.commands": {
         "commands": {
            "/reconnect": {
               "$ref": "json-schema:./component/GithubServiceManifest"
            }
         }
      }
   },
   "services": {
      "component": "./component#GithubController",
      "component.editor": "./component#GithubServiceEditor",
      "component.storage": "./component#GetStorageService",
      "component.commands": "./component#GetCommandsService"
   }
}