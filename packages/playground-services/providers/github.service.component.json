{
   "$id": "jtd:github.service",
   "title": "GitHub Repository Service",
   "icon": "fa:cloud",
   "component": {
      "services": [
         "storage"
      ],
      "data": {
         "type": "object",
         "properties": {
            "url": {
               "type": "string"
            },
            "password": {
               "type": "string"
            },
            "org": {
               "type": "string"
            },
            "repo": {
               "type": "string"
            },
            "branch": {
               "type": "string"
            }
         },
         "required": [
            "url",
            "password",
            "org",
            "branch"
         ]
      }
   },
   "services": {
      "component": "./github.service#GithubDriverService"
   }
}