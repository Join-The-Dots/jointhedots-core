{
   "name": "@jointhedots/ui",
   "version": "0.0.0",
   "type": "module",
   "private": true,
   "dots": true,
   "singleton": true,
   "packageManager": "pnpm@10.30.3",
   "dependencies": {
      "@jointhedots/core": "*",
      "@mui/material": "^6.4.7",
      "@rjsf/core": "^5.23.2",
      "@rjsf/utils": "^5.23.2",
      "@rjsf/validator-ajv8": "^5.23.2",
      "@salesforce-ux/design-system": "^2.29.0",
      "@salesforce/design-system-react": "^0.10.65",
      "react-toastify": "^11.0.5"
   },
   "peerDependencies": {
      "monaco-editor": ">=0.52.2",
      "react": ">=18.2.0",
      "react-dom": ">=18.2.0",
      "react-lightning-design-system": "^5.9.1"
   },
   "devDependencies": {
      "@jointhedots/core": "../jointhedots-core/dist/jointhedots-core",
      "@jointhedots/gear": "^1.2.5",
      "monaco-editor": ">=0.52.2",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "typescript": "^5.9.3"
   },
   "scripts": {
      "watch": "tsc --watch --noEmit",
      "build": "jointhedots-gear make --libs @jointhedots/ui --devmode --dist ./dist",
      "dev": "jointhedots-gear make --libs @jointhedots/ui --devmode --watch --dist ./dist",
      "deliver": "npm run build && cd ./dist/jointhedots-ui && npm publish --access public"
   }
}