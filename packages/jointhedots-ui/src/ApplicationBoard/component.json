{
   "$id": "jtd:application.board.component",
   "title": "Application Board",
   "icon": "utility:apps",
   "specs": {
      "component": {
         "attributes": {
            "entries": {
               "type": "object",
               "additionalProperties": {
                  "anyOf": [
                     {
                        "type": "string"
                     },
                     {
                        "type": "object",
                        "properties": {
                           "name": {
                              "type": "string",
                              "title": "App name, must be unique"
                           },
                           "icon": {
                              "type": "string"
                           },
                           "entries": {
                              "type": "object"
                           }
                        },
                        "required": [
                           "name",
                           "entries"
                        ]
                     }
                  ]
               }
            }
         }
      }
   },
   "apis": {
      "component": "./component#ApplicationBoardDriver",
      "component.view.react": "./component#GetApplicationView"
   }
}