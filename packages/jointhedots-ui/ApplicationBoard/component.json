{
   "$id": "jtd:application.board.component",
   "title": "Application Board",
   "icon": "utility:apps",
   "component": {
      "services": [
         "view.react"
      ],
      "attributes": {
         "entries": {
            "type": "object",
            "additionalProperties": {
               "anyOf": [
                  {
                     "type": "string"
                  },
                  {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "title": "App name, must be unique"
                        },
                        "icon": {
                           "type": "string"
                        },
                        "entries": {
                           "type": "object"
                        }
                     },
                     "required": [
                        "name",
                        "entries"
                     ]
                  }
               ]
            }
         }
      }
   },
   "services": {
      "component": "./component#ApplicationBoardDriver"
   }
}