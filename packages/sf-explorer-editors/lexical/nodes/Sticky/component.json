{
   "id": "sticky",
   "description": "Sticky note in air",
   "icon": "bi:sticky-fill",
   "view": {
      "properties": {
         "caption": {
            "type": "element"
         },
         "color": {
            "type": "string",
            "format": "text/color",
            "default": "yellow"
         },
         "xOffset": {
            "type": "number",
            "default": 0
         },
         "yOffset": {
            "type": "number",
            "default": 0
         }
      }
   },
   "attachments": {
      "view.lexical": "./StickyNode#StickyNode",
      "addon.lexical": "./StickyPlugin"
   }
}