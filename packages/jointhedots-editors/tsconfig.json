{
   "compilerOptions": {
      "target": "es2022",
      "skipLibCheck": true,
      "allowSyntheticDefaultImports": true,
      "strict": false,
      "module": "ES2022",
      "moduleResolution": "bundler",
      "noUnusedLocals": false,
      "sourceMap": true,
      "rootDir": ".",
      "jsx": "react-jsx",
      "lib": [
         "es2022",
         "dom",
         "dom.iterable"
      ],
      "paths": {
         "@jointhedots/editors/*": [
            "./src/*"
         ],
      },
   },
   "include": [
      "src"
   ]
}