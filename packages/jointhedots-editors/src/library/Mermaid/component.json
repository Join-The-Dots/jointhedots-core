{
   "$id": "mermaid",
   "description": "Mermaid diagram displayer",
   "icon": "bi:diagram-3-fill",
   "specs": {
      "view": {
         "properties": {
            "code": {
               "type": "string",
               "format": "text/mermaid",
               "examples": "pie\n\"Dogs\" : 386\n\"Cats\" : 85.9\n\"Rats\" : 15"
            }
         }
      }
   },
   "services": {
      "view.react": "./Mermaid#MermaidComponent"
   }
}