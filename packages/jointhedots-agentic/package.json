      "@types/yargs": "^17.0.35",
      "@vscode/vscode-languagedetection": "^1.0.22",
      "marked": "^17.0.1",
      "ollama": "^0.6.3",
      "openai": "^6.14.0",
      "yargs": "^18.0.0",
      "zod": "^4.3.5"
   },
   "devDependencies": {
