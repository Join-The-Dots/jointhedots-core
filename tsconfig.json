{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": false,
    "strict": false,
    "downlevelIteration": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist/lib",
    "jsx": "react-jsx",
    "paths": {
      "@jointhedots/core/*": [
        "./packages/jointhedots-core/*"
      ],
      "@jointhedots/ui/*": [
        "./packages/jointhedots-ui/*"
      ],
      "@jointhedots/editors/*": [
        "packages/jointhedots-editors/*"
      ]
    },
    "plugins": [
      {
        "transform": "typescript-transform-paths"
      }
    ]
  },
  "include": [
    "packages"
  ]
}