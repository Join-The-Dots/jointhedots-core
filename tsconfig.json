{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": false,
    "strict": false,
    "downlevelIteration": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "shared/*": [
        "./src/lexical-editor/shared/*"
      ],
      "*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}